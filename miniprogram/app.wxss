page {
  background: #f5f8f7;
  color: #203b35;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
}
view,
button,
input {
  box-sizing: border-box;
}
.page {
  max-width: 960rpx;
  margin: 0 auto;
  padding: 36rpx 32rpx 64rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.grow {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.title {
  font-size: 44rpx;
  font-weight: 650;
  line-height: 1.4;
  margin: 10rpx 0 24rpx;
  letter-spacing: -1rpx;
}
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #65887e;
}
.section-title {
  font-size: 31rpx;
  font-weight: 600;
}
.section {
  margin-top: 32rpx;
  margin-bottom: 18rpx;
}
.card {
  background: #fff;
  border: 1rpx solid #e4ece8;
  border-radius: 24rpx;
  padding: 28rpx;
}
.hero {
  background: #164e45;
  color: #f7fffb;
  border-radius: 28rpx;
  padding: 34rpx;
}
.hero-title {
  font-size: 38rpx;
  font-weight: 600;
}
.hero-sub {
  color: #b9d4cb;
  margin: 12rpx 0 28rpx;
}
button {
  font-size: 28rpx;
  border-radius: 16rpx;
  line-height: 1.4;
  padding: 24rpx 28rpx;
  margin: 20rpx 0 0;
  font-weight: 500;
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: 0.45;
}
.primary {
  color: #fff;
  background: #167568;
}
.secondary {
  color: #23564a;
  background: #e7f0ec;
}
.hero-button {
  color: #194d41;
  background: #dbf1e6;
  display: inline-block;
  margin: 0;
  padding: 18rpx 28rpx;
}
.compact {
  font-size: 26rpx;
  padding: 18rpx 24rpx;
  margin: 0;
  flex-shrink: 0;
}
.text-button {
  padding: 12rpx 8rpx;
  margin: 0;
  background: transparent;
  color: #26796c;
  font-size: 25rpx;
}
.stats {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.stat {
  flex: 1;
  background: #eaf1ed;
  border-radius: 22rpx;
  padding: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.number {
  font-size: 52rpx;
  font-weight: 650;
}
.unit {
  font-size: 23rpx;
  font-weight: 400;
}
.muted {
  color: #71857e;
  font-size: 25rpx;
}
.caption {
  color: #71857e;
  font-size: 23rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}
.link {
  color: #167568;
  font-size: 25rpx;
  flex-shrink: 0;
}
.task-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf1ee;
}
.task-row:first-child {
  padding-top: 0;
}
.task-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}
.check {
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  margin: 0;
  flex-shrink: 0;
  background: #f2f7f4;
  color: #167568;
  font-size: 40rpx;
  line-height: 60rpx;
}
.item-title {
  font-size: 29rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.event-row {
  border-left: 5rpx solid #8ab6a4;
  padding: 6rpx 0 8rpx 22rpx;
  margin: 20rpx 0;
}
.event-row:first-child {
  margin-top: 0;
}
.event-row:last-child {
  margin-bottom: 0;
}
.time {
  font-size: 25rpx;
  color: #267567;
  font-weight: 550;
}
.empty {
  color: #81958b;
  padding: 36rpx 12rpx;
  font-size: 26rpx;
  text-align: center;
  line-height: 1.7;
}
.demo {
  font-size: 23rpx;
  background: #fff2d9;
  color: #87642e;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 22rpx;
}
.notice {
  font-size: 25rpx;
  line-height: 1.7;
  color: #627c71;
  margin: 20rpx 0;
  overflow-wrap: anywhere;
}
.input {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 88rpx;
  background: #f1f5f3;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  font-size: 27rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  padding: 16rpx 22rpx;
  border-radius: 30rpx;
  background: #eaf0ed;
  font-size: 24rpx;
  color: #688378;
}
.chip.active {
  background: #167568;
  color: #fff;
}
.done {
  text-decoration: line-through;
  color: #87968e;
}
.editor {
  margin-top: 28rpx;
}
.actions button {
  flex: 1;
}
.danger {
  color: #ab574b;
  margin-top: 16rpx;
}
.date-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #eaf1ed;
  padding: 14rpx;
  border-radius: 16rpx;
}
.badge {
  font-size: 21rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #edf4ef;
  color: #749082;
}
.focus-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 44rpx 32rpx;
  text-align: center;
  margin: 22rpx 0;
  border: 1rpx solid #e4ece8;
}
.focus-label {
  font-size: 25rpx;
  color: #668779;
  letter-spacing: 3rpx;
}
.timer {
  font-size: 114rpx;
  font-weight: 300;
  font-variant-numeric: tabular-nums;
  letter-spacing: -4rpx;
  color: #20564a;
  padding: 22rpx 0;
}
.focus-controls {
  margin: 30rpx 0;
}
.duration-input {
  width: 110rpx;
  padding: 18rpx;
  background: #f1f5f3;
  border-radius: 12rpx;
  margin-top: 12rpx;
  text-align: center;
}
.record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1ee;
}
.record-row:last-child {
  border-bottom: 0;
}
.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.paragraph {
  margin-top: 16rpx;
}
.small-logo {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
.sync-line {
  margin-top: 24rpx;
}
.center {
  text-align: center;
}
.login {
  padding-top: 68rpx;
}
.brand-icon {
  width: 110rpx;
  height: 110rpx;
  margin-bottom: 28rpx;
}
.brand-title {
  font-size: 64rpx;
  font-weight: 650;
  margin-top: 10rpx;
}
.tagline {
  color: #6c897d;
  font-size: 30rpx;
  margin: 12rpx 0 42rpx;
}
.login-card {
  padding: 32rpx;
}
.links {
  font-size: 25rpx;
  color: #548471;
  margin: 26rpx 0 4rpx;
}
.page {
  --bg: #f3f8fb;
  --card: #ffffff;
  --ink: #183f4e;
  --muted: #6d8790;
  --accent: #086b91;
  --soft: #e6f1f5;
  --on-accent: #ffffff;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}
.card,
.focus-card {
  background: var(--card);
  border-color: var(--soft);
}
.input,
.stat,
.chip,
.date-bar,
.duration-input,
.check,
.badge,
.secondary {
  background: var(--soft);
  color: var(--ink);
}
.primary,
.chip.active,
.hero {
  background: var(--accent);
  color: var(--on-accent);
}
.hero-sub {
  color: inherit;
  opacity: 0.8;
}
.hero-button {
  background: var(--card);
  color: var(--accent);
}
.caption,
.muted,
.empty,
.notice,
.eyebrow,
.focus-label {
  color: var(--muted);
}
.link,
.time,
.timer,
.text-button,
.check,
.links {
  color: var(--accent);
}
.task-row,
.record-row {
  border-color: var(--soft);
}
.event-row {
  border-color: var(--accent);
}
.danger {
  color: #b96456;
}
.theme-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.theme-choice {
  width: calc(50% - 9rpx);
  padding: 24rpx;
  border: 3rpx solid var(--soft);
  background: var(--card);
  border-radius: 20rpx;
  font-size: 25rpx;
}
.theme-choice.selected {
  border-color: var(--accent);
}
.swatches {
  display: flex;
  margin-bottom: 18rpx;
}
.swatch {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  border: 1rpx solid rgba(120, 120, 120, 0.15);
}
