<view class="page" style="{{themeStyle}}">
  <view class="row"><view><view class="eyebrow">THINGS TO DO</view><view class="title">任务</view></view><button class="primary compact" bindtap="add">＋ 新任务</button></view>
  <view wx:if="{{demo}}" class="demo">演示工作区</view>
  <view class="chips"><text class="chip {{filter === 'all' ? 'active' : ''}}" data-id="all" bindtap="filter">全部</text><text wx:for="{{quadrants}}" wx:key="id" class="chip {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.title}}</text></view>
  <view class="row section"><text class="caption">{{tasks.length}} 项{{showCompleted ? '已完成' : '待办'}}</text><text class="link" bindtap="completed">{{showCompleted ? '查看待办' : '查看已完成'}}</text></view>
  <view class="card"><view wx:for="{{tasks}}" wx:key="id" class="task-row"><button class="check" data-id="{{item.id}}" bindtap="toggle" aria-label="切换完成状态">{{item.completedAt ? '●' : '○'}}</button><view class="grow" data-id="{{item.id}}" bindtap="edit"><view class="item-title {{item.completedAt ? 'done' : ''}}">{{item.title}}</view><view class="caption">{{item.label}} · {{item.project}} {{item.due}}</view></view><text class="muted" data-id="{{item.id}}" bindtap="edit">›</text></view><view wx:if="{{!tasks.length}}" class="empty">这里还没有任务。</view></view>
  <view wx:if="{{editing}}" class="editor card"><view class="section-title">{{editId ? '编辑任务' : '新任务'}}</view><input class="input" placeholder="需要做什么？" data-field="title" value="{{title}}" bindinput="field" maxlength="300"/><input class="input" placeholder="清单，例如学习、科研" data-field="project" value="{{project}}" bindinput="field" maxlength="60"/><picker range="{{quadrants}}" range-key="title" value="{{quadrant}}" data-field="quadrant" bindchange="field"><view class="input">{{quadrants[quadrant].title}}　⌄</view></picker><view class="row"><picker mode="date" value="{{due}}" data-field="due" bindchange="field"><view class="input">{{due || '选择截止日期'}}　⌄</view></picker><text class="link" bindtap="clearDate">清除日期</text></view><view class="row actions"><button class="secondary" bindtap="cancel">取消</button><button class="primary" bindtap="save">保存</button></view><button wx:if="{{editId}}" class="text-button danger" bindtap="remove">移入回收站</button></view>
</view>
