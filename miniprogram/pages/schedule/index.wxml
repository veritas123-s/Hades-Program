<view class="page" style="{{themeStyle}}"><view class="row"><view><view class="eyebrow">YOUR SCHEDULE</view><view class="title">日程与课表</view></view><button class="primary compact" bindtap="add">＋ 日程</button></view><view wx:if="{{demo}}" class="demo">演示工作区</view>
  <view class="date-bar"><button class="text-button" data-step="-1" bindtap="move">‹</button><picker mode="date" value="{{day}}" bindchange="day"><text class="section-title">{{day}}　⌄</text></picker><button class="text-button" data-step="1" bindtap="move">›</button><text class="link" bindtap="today">今天</text></view>
  <view class="notice">{{coverage}}</view><view class="caption">日程及课表按北京时间显示</view>
  <view class="card section"><view wx:for="{{items}}" wx:key="id" class="event-row"><view class="row"><text class="time">{{item.clock}}</text><text class="badge">{{item.kind === 'course' ? '课程' : item.kind === 'task' ? '任务' : '日程'}}</text></view><view class="item-title">{{item.title}}</view><view class="caption">{{item.detail}}</view><text wx:if="{{item.kind === 'event'}}" class="link" data-id="{{item.event.id}}" bindtap="remove">移入回收站</text></view><view wx:if="{{!items.length}}" class="empty">这一天还没有已保存的安排。</view></view>
  <view wx:if="{{editing}}" class="card editor"><view class="section-title">新日程 · {{day}}</view><input class="input" placeholder="日程名称" data-field="title" value="{{title}}" bindinput="field" maxlength="300"/><view class="row"><picker mode="time" value="{{startTime}}" data-field="startTime" bindchange="field"><view class="input">开始 {{startTime}}</view></picker><picker mode="time" value="{{endTime}}" data-field="endTime" bindchange="field"><view class="input">结束 {{endTime}}</view></picker></view><input class="input" placeholder="地点（可选）" data-field="location" value="{{location}}" bindinput="field" maxlength="200"/><view class="row actions"><button class="secondary" bindtap="cancel">取消</button><button class="primary" bindtap="save">保存</button></view></view>
</view>
